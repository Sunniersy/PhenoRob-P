<root main_tree_to_execute="MainTree">
    <!--===========================NavSubtree=========================== -->
      <BehaviorTree ID="OpenDoorNavSubtree">
        <Sequence ID="navtopose">
          <Inverter>
            <AtTargetRoomCondition nav_target_room="{sub_target_room}"/>
          </Inverter>
          <Fallback name="opendoor">
            <Sequence name="doorsequence">
              <CheckIfNeedOpenDoor nav_target_room="{sub_target_room}" 
                                  door_y="-4.9" 
                                  target_door="{target_door}" />
              <MoveBaseToRoom nav_target_room="{target_door}" />
              <OpenDoorAction />
              <MoveBaseToRoom nav_target_room="{sub_target_room}" />
            </Sequence>
            <Sequence name="direct_nav_sequence">
              <MoveBaseToRoom nav_target_room="{sub_target_room}" />
            </Sequence>
          </Fallback>
          <ClearGlobalCostmapNode nav_target_room="{sub_target_room}"/>
        </Sequence>
      </BehaviorTree>
    
    <!-- ==========================maintree============================== -->
      <BehaviorTree ID="MainTree">
        <Parallel success_threshold="2" failure_threshold="2"> 
        <!-- ================================tasklistener================================= -->
          <NewTaskListener nav_target_room="{nav_target_room}" 
                          voice_task_command="{voice_task_command}"
                          task_locked="{task_locked}"/>
          <AlwaysSuccess/>
        </Parallel>
        <!-- =========================================taskhandler========================= -->
          <RepeatUntilFailure>
          <Fallback ID="TaskHandler">   
            <!-- ===============================stop_charge========================== -->
            <Sequence>
              <IsCommand voice_task_command="{voice_task_command}" task_type="Stopcharge"/>
              <Fallback>
                <Inverter>
                  <IsChargingCondition IsCharging="{IsCharging}"/>
                </Inverter>
                <StopChargingAction IsCharging="{IsCharging}"/>
              </Fallback>
              <SetBlackboard output_key="task_locked" value="false"/>
              <ClearTaskCommand voice_task_command="{voice_task_command}" nav_target_room="{nav_target_room}" />
            </Sequence>
    
            <!-- =================================NAV============================== -->
            <Sequence ID="Nav">
              <IsCommand voice_task_command="{voice_task_command}" task_type="Nav"/>
              <ReactiveFallback ID="Wait">
                <GoalUpdate nav_target_room="{nav_target_room}"/>
                <Sequence>
                  <SubTree ID="OpenDoorNavSubtree" sub_target_room="nav_target_room"/>
                  <Fallback ID="WAIT">
                    <Timeout msec="180000">
                      <WaitAtTargetPose/>
                    </Timeout>
                    <Sequence>
                      <SetBlackboard output_key="voice_task_command" value="Park"/>
                      <SetBlackboard output_key="nav_target_room" value="park_room"/>
                      <SubTree ID="OpenDoorNavSubtree" sub_target_room="nav_target_room"/>
                    </Sequence>
                  </Fallback>
                </Sequence>
              </ReactiveFallback>
            </Sequence>
            <!-- =================================Park============================= -->
            <Sequence ID="Park">
              <IsCommand voice_task_command="{voice_task_command}" task_type="Park"/>
              <ReactiveFallback>
                <GoalUpdate nav_target_room="{nav_target_room}"/>
                <SubTree ID="OpenDoorNavSubtree" sub_target_room="nav_target_room"/>
              </ReactiveFallback>
              <ClearTaskCommand voice_task_command="{voice_task_command}" nav_target_room="{nav_target_room}" />
            </Sequence>
            <!-- =================================Charge============================= -->
            <Sequence>
              <IsCommand voice_task_command="{voice_task_command}" task_type="Charge"/>
              <SubTree ID="OpenDoorNavSubtree" sub_target_room="nav_target_room"/>
              <SetBlackboard output_key="task_locked" value="true"/>
              <Fallback ID="Charge">
                <IsChargingCondition IsCharging="{IsCharging}"/>
                <Sequence>
                  <LocateChargingStation/>
                  <DockToChargingStation IsCharging="{IsCharging}"/>
                </Sequence>
              </Fallback>
              <ClearTaskCommand voice_task_command="{voice_task_command}" nav_target_room="{nav_target_room}" />
            </Sequence>
          </Fallback>
          </RepeatUntilFailure>
      </BehaviorTree>
    </root>
