<launch>
    <!-- 添加充电站可视化标记节点 -->
    <node pkg="RobotCar" type="charge_station_marker" name="charging_station_marker" output="screen">
        <!-- Marker位置参数 -->
        <param name="marker_pos_x" value="-1.9" />
        <param name="marker_pos_y" value="0.0" />
        <param name="marker_pos_z" value="0.2" />
        <!-- Marker姿态参数 -->
        <param name="marker_ori_x" value="0.0" />
        <param name="marker_ori_y" value="0.0" />
        <param name="marker_ori_z" value="0.0" />
        <param name="marker_ori_w" value="1.0" />
        <!-- Marker尺寸参数 -->
        <param name="marker_scale_x" value="0.3" />
        <param name="marker_scale_y" value="0.6" />
        <param name="marker_scale_z" value="0.4" />
    </node>
    
    <!-- 通过 bash sleep 命令延迟2秒启动 -->
    <node pkg="RobotCar" type="auto_charge_test" name="auto_charge_test" output="screen"
          launch-prefix="bash -c 'sleep 3; $0 $@'">
        <!-- 原有参数 -->
        <param name="tag_id" value="0" />
        <param name="tag_size" value="0.07" />
        <param name="pose_range_x" value="0.64" />
        <param name="pose_range_y" value="0.02" />
        <param name="angle_range_z" value="0.04" />
        <param name="point_a" value="1.5" />
        <param name="range_point_a_x" value="0.04" />
        <param name="range_point_a_y" value="0.04" />
        <param name="Charge_enable" value="false" />
    </node>
</launch>