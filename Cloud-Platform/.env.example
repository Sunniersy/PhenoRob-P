# ============================================================================
# SECURITY WARNING -- DO NOT USE THIS FILE DIRECTLY
# ============================================================================
# This is a TEMPLATE. Copy it to .env and replace ALL placeholder values
# before starting the application.
#
# NEVER commit your .env file to version control.
#
# Generate secure secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# ============================================================================

APP_ENV=production
FLASK_DEBUG=false
SECRET_KEY=replace-with-a-strong-secret
JWT_SECRET=replace-with-a-strong-jwt-secret
BOOTSTRAP_TOKEN=replace-with-a-bootstrap-token
ALLOW_RUNTIME_FALLBACK=false
API_HOST=0.0.0.0
API_PORT=5000
API_BASE_URL=http://backend:5000
FRONTEND_BASE_URL=https://robot-cloud.example.com
# WARNING: Change the database password before deploying to production
DATABASE_URL=postgresql+psycopg://postgres:replace-with-db-password@postgres:5432/phenobot
REDIS_URL=redis://redis:6379/0
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_USERNAME=replace-with-mqtt-username
MQTT_PASSWORD=replace-with-mqtt-password
MQTT_CLIENT_ID=cloud-server-prod
MQTT_QOS=1
TRANSPORT_BACKEND=mqtt
TASK_QUEUE_BACKEND=celery
TASK_QUEUE_EAGER=false
STORAGE_BACKEND=minio
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=replace-with-minio-root-user
MINIO_ROOT_PASSWORD=replace-with-minio-root-password
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret-key
MINIO_BUCKET=phenobot-assets
MINIO_SECURE=false
LOCAL_STORAGE_PATH=storage
WEBSOCKET_ENABLED=true
ANALYSIS_LATENCY_SECONDS=1
ANALYSIS_PROVIDER=http
ANALYSIS_HTTP_ENDPOINT=https://analysis.example.com/v1/analyze
ANALYSIS_HTTP_TOKEN=replace-with-analysis-token
PASSWORD_MIN_LENGTH=12
MAX_UPLOAD_SIZE_BYTES=33554432
ROBOT_OFFLINE_TTL_SECONDS=30
MQTT_PROTOCOL_VERSION=1.0
APP_VERSION=0.2.0
APP_HTTP_PORT=80
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
MQTT_HOST_PORT=1883
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
# Demo-only helpers used by simulator, smoke, and `./scripts/docker_stack.sh demo-reset-admin`
# Warm-start stacks keep the password stored in the database until you reset it explicitly.
# WARNING: These credentials are for local development/testing only.
# Generate strong passwords for any non-local deployment.
# Optional demo-only overrides when running the bundled simulator
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=replace-with-demo-admin-password
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-demo-admin-password
SIM_ROBOT_CODE=robot-demo-001
SMOKE_ROBOT_CODE=robot-demo-001
