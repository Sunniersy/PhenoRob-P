# ============================================================================
# DEMO / LOCAL-ONLY environment -- NEVER use in production
# ALLOW_RUNTIME_FALLBACK=true bypasses the safety validator so that demo-*
# prefixed secrets can be used.  In a real production deployment this flag
# MUST be false and all demo-* secrets MUST be replaced.
# ============================================================================
APP_ENV=production
FLASK_DEBUG=false
SECRET_KEY=demo-secret-key-for-compose-only-32
JWT_SECRET=demo-jwt-secret-key-for-compose-only-32
BOOTSTRAP_TOKEN=demo-bootstrap-token-for-compose-only
ALLOW_RUNTIME_FALLBACK=true
API_HOST=0.0.0.0
API_PORT=5000
API_BASE_URL=http://backend:5000
FRONTEND_BASE_URL=http://localhost
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/phenobot
REDIS_URL=redis://redis:6379/0
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_USERNAME=demo-mqtt-user
MQTT_PASSWORD=demo-mqtt-pass-32
MQTT_CLIENT_ID=cloud-server-compose
MQTT_QOS=1
TRANSPORT_BACKEND=mqtt
TASK_QUEUE_BACKEND=celery
TASK_QUEUE_EAGER=false
STORAGE_BACKEND=minio
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=demo-minio-root
MINIO_ROOT_PASSWORD=demo-minio-root-secret-32
MINIO_ACCESS_KEY=demo-minio-root
MINIO_SECRET_KEY=demo-minio-root-secret-32
MINIO_BUCKET=phenobot-assets
MINIO_SECURE=false
LOCAL_STORAGE_PATH=storage
WEBSOCKET_ENABLED=true
ANALYSIS_LATENCY_SECONDS=0
ANALYSIS_PROVIDER=demo
ANALYSIS_HTTP_ENDPOINT=
ANALYSIS_HTTP_TOKEN=
PASSWORD_MIN_LENGTH=12
MAX_UPLOAD_SIZE_BYTES=33554432
ROBOT_OFFLINE_TTL_SECONDS=30
MQTT_PROTOCOL_VERSION=1.0
APP_VERSION=0.2.0-demo
APP_HTTP_PORT=80
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
MQTT_HOST_PORT=1883
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=demo-admin-pass-DO-NOT-USE-IN-PROD-2026
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=demo-admin-pass-DO-NOT-USE-IN-PROD-2026
SIM_ROBOT_CODE=robot-demo-001
SMOKE_ROBOT_CODE=robot-demo-001
